# Agritech Cloud Model Stack Configuration
# Place your Gemini API Key here for Smart Fallback & Multimodal Reasoning
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Model Inference Settings
CONFIDENCE_THRESHOLD=0.80
DEVICE=cuda
HOST=0.0.0.0
PORT=8000

# Path Settings (Dataset strictly from MAIN DATA)
MAIN_DATA_PATH=MAIN DATA
WEIGHTS_DIR=weights
